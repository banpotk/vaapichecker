     </widget>
     <widget class="QPlainTextEdit" name="traceDetails">
      <property name="readOnly"><bool>true</bool></property>
      <property name="maximumBlockCount"><number>10000</number></property>
      <property name="placeholderText"><string notr="true">Select an event to see full details.</string></property>
