<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>UsageTab</class>
 <widget class="QWidget" name="usagePage">
  <layout class="QVBoxLayout" name="usageLayout" stretch="0,0,1,0">
   <item>
    <layout class="QHBoxLayout" name="usageTools">
     <item>
      <widget class="QLabel" name="intervalLabel">
       <property name="text"><string notr="true">Sample interval:</string></property>
      </widget>
     </item>
     <item>
      <widget class="QSpinBox" name="sampleInterval">
       <property name="minimum"><number>500</number></property>
       <property name="maximum"><number>10000</number></property>
       <property name="singleStep"><number>500</number></property>
       <property name="value"><number>1000</number></property>
       <property name="suffix"><string notr="true"> ms</string></property>
      </widget>
     </item>
     <item>
      <spacer name="usageToolsSpacer">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="sizeType"><enum>QSizePolicy::Expanding</enum></property>
       <property name="sizeHint" stdset="0">
        <size>
         <width>40</width>
         <height>20</height>
        </size>
       </property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="saveUsageButton">
       <property name="text"><string notr="true">Save snapshot…</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="startMonitorButton">
       <property name="text"><string notr="true">Start monitoring</string></property>
       <property name="enabled"><bool>false</bool></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QLabel" name="usageDescription">
     <property name="text"><string notr="true">Per-process engine utilization from /proc/&lt;pid&gt;/fdinfo. Only accessible DRM clients are included; shared clients are counted once.</string></property>
     <property name="wordWrap"><bool>true</bool></property>
     <property name="textFormat"><enum>Qt::PlainText</enum></property>
     <property name="textInteractionFlags"><set>Qt::TextSelectableByMouse</set></property>
    </widget>
   </item>
   <item>
    <widget class="QTableView" name="usageTable">
     <property name="alternatingRowColors"><bool>true</bool></property>
     <property name="showGrid"><bool>false</bool></property>
     <property name="selectionBehavior"><enum>QAbstractItemView::SelectRows</enum></property>
     <property name="selectionMode"><enum>QAbstractItemView::SingleSelection</enum></property>
     <property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="usageStatus">
     <property name="text"><string notr="true">Monitoring stopped. Engine names are provided by the kernel driver.</string></property>
     <property name="wordWrap"><bool>true</bool></property>
     <property name="textFormat"><enum>Qt::PlainText</enum></property>
     <property name="textInteractionFlags"><set>Qt::TextSelectableByMouse</set></property>
    </widget>
   </item>
  </layout>
 </widget>
</ui>
